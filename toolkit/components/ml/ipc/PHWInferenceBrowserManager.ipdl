include protocol PTextGeneration;

include TextGenerationTypes;

namespace mozilla {
namespace hwinference {

// Browser-side manager for inference generators in the HWInference utility
// process. The parent lives in the main process, which is the only side
// that starts anything: the utility process can only act on what it is
// handed, so the model arrives as an already-open file descriptor in the
// generator constructor and there is no request-by-name message. Bootstrap
// mirrors the content manager: the main process creates the endpoint pair
// and hands the child end over PHWInference
// (NewBrowserHWInferenceManager).
[ChildProc=Utility]
protocol PHWInferenceBrowserManager
{
  manages PTextGeneration;

child:
  async PTextGeneration(FileDescriptor model, TextGenerationOptions options);
};

}  // namespace hwinference
}  // namespace mozilla
