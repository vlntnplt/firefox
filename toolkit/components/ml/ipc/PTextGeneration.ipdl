include protocol PHWInferenceBrowserManager;

include TextGenerationTypes;

namespace mozilla {
namespace hwinference {

protocol PTextGeneration
{
  manager PHWInferenceBrowserManager;

parent:
  // Sent exactly once, when the construction-time model load finishes.
  async Ready(LoadResult result);
  async Delta(nsCString text);

child:
  // One in flight at a time; the reply follows the last Delta.
  async Generate(GenerateRequest request) returns (GenerateResponse response);
  async Clear();
  // Best-effort; the pending Generate still resolves, with reason cancelled.
  async Cancel();
  async __delete__();
};

}  // namespace hwinference
}  // namespace mozilla
