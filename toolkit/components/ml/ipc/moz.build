with Files("**"):
    BUG_COMPONENT = ("Core", "Machine Learning")

EXPORTS.mozilla.hwinference += [
    "HWInferenceBrowserManagerChild.h",
    "HWInferenceBrowserManagerParent.h",
    "HWInferenceChild.h",
    "HWInferenceLog.h",
    "HWInferenceManagerChild.h",
    "HWInferenceManagerParent.h",
    "HWInferenceParent.h",
]

UNIFIED_SOURCES += [
    "HWInferenceBrowserManagerChild.cpp",
    "HWInferenceBrowserManagerParent.cpp",
    "HWInferenceChild.cpp",
    "HWInferenceManagerChild.cpp",
    "HWInferenceManagerParent.cpp",
    "HWInferenceParent.cpp",
]

IPDL_SOURCES = [
    "PHWInference.ipdl",
    "PHWInferenceManager.ipdl",
]

PREPROCESSED_IPDL_SOURCES = [
    "PHWInferenceBrowserManager.ipdl",
]

LOCAL_INCLUDES += [
    "/dom/ipc",
    "/ipc/glue",
]

if CONFIG["MOZ_WIDGET_TOOLKIT"] != "android":
    EXPORTS.mozilla.hwinference += [
        "TextGenerationChild.h",
        "TextGenerationEnums.h",
        "TextGenerationParent.h",
    ]

    UNIFIED_SOURCES += [
        "TextGenerationChild.cpp",
        "TextGenerationParent.cpp",
    ]

    IPDL_SOURCES += [
        "PTextGeneration.ipdl",
        "TextGenerationTypes.ipdlh",
    ]

    LOCAL_INCLUDES += [
        "/third_party/llama.cpp/ggml/include",
        "/third_party/llama.cpp/include",
        "/toolkit/components/ml/backends/llama",
    ]

include("/ipc/chromium/chromium-config.mozbuild")

FINAL_LIBRARY = "xul"
