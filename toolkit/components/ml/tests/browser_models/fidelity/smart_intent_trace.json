{
  "schema_version": 1,
  "models": {
    "intent": {
      "model_id": "mozilla/mobilebert-query-intent-detection",
      "revision": "v0.4.0"
    },
    "intent_en_fr": {
      "model_id": "mozilla/query-intent-detection-en-fr",
      "revision": "v0.1.2"
    }
  },
  "reference": {
    "runtime": "firefox",
    "backend": "onnx-native",
    "device": "cpu",
    "dtype": "fp32",
    "note": "produced by driving IntentClassifier.getPromptIntent at fp32, so the trace measures the cost of the q8 weights that ship. Examples whose search probability sits within 0.3 of the 0.8 threshold getPromptIntent applies were rejected, so the recorded intent is usable as an oracle."
  },
  "tolerances": {
    "kld_max": {
      "intent": 0.1,
      "intent_en_fr": 0.05
    },
    "result_accuracy_min": 1.0
  },
